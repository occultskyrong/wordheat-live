# Mac/Linux backend development configuration. All values are intentionally empty.
# Copy to an owner-only 0600 .env in an explicit configuration root.
# No environment interpolation; duplicate/unknown fields are rejected.
# WORDHEAT_ENV accepts development/test/production; it never grants live gates.
WORDHEAT_ENV=
WORDHEAT_INSTANCE_ID=

# API runtime role, separate from the migration role. Dedicated local WordHeat DB.
LOCAL_DATABASE_URL=
LOCAL_MIGRATION_DATABASE_URL=

# Server-only 32-byte cursor key as 64 lowercase hex characters.
LOCAL_ANALYTICS_CURSOR_KEY=

# Explicit installed source root. Runtime entry supplies its verified source root.
LOCAL_SOURCE_ROOT=
# Defaults derive from the explicit config root, never current working directory.
LOCAL_NATIVE_ROOT=
LOCAL_MAINTENANCE_ROOT=
LOCAL_CONTROL_ROOT=

# Optional official control plane. Missing material keeps official fail-closed;
# local rehearsal and setup remain available. Files must be private, not Web-set.
LOCAL_GATE_TRUST_ROOTS_FILE=
LOCAL_CONNECTOR_REGISTRY_FILE=
# Mac long-term possession seed only, canonical unpadded base64url of 32 bytes.
# Restricted native initialization may atomically persist it in this 0600 .env.
# Short device tokens, launch tokens and per-boot API/scorer keys NEVER go here.
LOCAL_DEVICE_PRIVATE_KEY_B64URL=
LOCAL_DEVICE_PAIRING_ID=
# Reserved for a future encrypted native/DPAPI adapter; never a raw-key JSON file.
LOCAL_DEVICE_CREDENTIAL_FILE=

# Release/candidate public keys have separate purposes from gate trust roots.
# Backups use a private SHA-pinned registry, not a release/gate signing key.
LOCAL_RELEASE_PUBLIC_KEYS_FILE=
LOCAL_CANDIDATE_ROOT=
LOCAL_CANDIDATE_MANIFEST_FILE=
LOCAL_CANDIDATE_PUBLIC_KEYS_FILE=
# Optional fixed local PG tooling/restore-target registration; no DSN/password.
# Missing registration fails backup/restore execution with a configuration reason.
LOCAL_MAINTENANCE_REGISTRY_FILE=

# QA only. Existing parent-owned schemas; never creates/drops a schema.
# LOCAL_TEST_NAMESPACE_FILE is rejected outside WORDHEAT_ENV=test, has no public
# fallback, cannot authorize production, and constrains backup to the same schema.
LOCAL_TEST_NAMESPACE_FILE=
WORDHEAT_TEST_DATABASE_URL=
WORDHEAT_TEST_MIGRATION_DATABASE_URL=
